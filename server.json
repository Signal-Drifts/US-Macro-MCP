{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.hgus107/us-macro-mcp",
  "title": "US Macro",
  "description": "US macroeconomic data from FRED: inflation, employment, growth, housing, rates, recession signals.",
  "version": "0.1.1",
  "repository": {
    "url": "https://github.com/hgus107/US-Macro-MCP",
    "source": "github"
  },
  "websiteUrl": "https://github.com/hgus107/US-Macro-MCP",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "us-macro-mcp",
      "version": "0.1.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "FRED_API_KEY",
          "description": "Free API key from https://fredaccount.stlouisfed.org/apikeys",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}